# Vercel → Settings → Environment Variables 에 넣는 값 (실제 값은 저장소에 올리지 않음)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # Supabase → Project Settings → API → service_role (절대 공개 금지)
BOT_TOKEN=                        # @BotFather 가 준 수업용 봇 토큰
NEXT_PUBLIC_BOT_USERNAME=storykorean_bot  # 봇 아이디 (@ 없이)
SESSION_SECRET=                   # 아무 긴 글자 (로그인 쿠키 서명용) — openssl rand -hex 32
OWNER_IDS=                        # 대표 텔레그램 번호 (여러 명이면 쉼표)
